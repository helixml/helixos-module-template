{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.helix.ml/docs/modules/manifest.schema.json",
  "title": "Module manifest (contract v1)",
  "description": "Served by a module at /.well-known/helixos-module.json. See contract-v1.md section 3.",
  "type": "object",
  "required": ["schema_version", "key", "name", "version", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 500 },
    "icon": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["key", "label", "path"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "icon": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" },
          "path": { "$ref": "#/$defs/path" }
        },
        "additionalProperties": true
      }
    },
    "mcp": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "$ref": "#/$defs/path" } }
    },
    "events": {
      "type": "object",
      "required": ["path", "subscribe"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "subscribe": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" } }
      }
    },
    "host_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
    },
    "agent_tool_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "required_integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "health": { "$ref": "#/$defs/path" }
  },
  "additionalProperties": true,
  "$defs": {
    "path": {
      "type": "string",
      "description": "Relative to the module origin: starts with '/', no scheme/host, no '..', '#' or '?'.",
      "pattern": "^/(?!/)[^?#]*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" },
      "maxLength": 200
    }
  }
}
